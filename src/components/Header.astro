---
import { nav, site, donateHref } from '../config/site';
import LogoMark from './LogoMark.astro';
import Icon from './Icon.astro';
import Button from './Button.astro';

const current = Astro.url.pathname.replace(/\/?$/, '/');
const isCurrent = (href: string) => current === href || (href !== '/' && current.startsWith(href));
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a href="/" class="brand">
      <LogoMark size={42} />
      <span class="brand__word">
        <span class="brand__courage">Courage</span>
        <span class="brand__for">for Kids</span>
      </span>
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
      <span class="menu-toggle__open"><Icon name="menu" /></span>
      <span class="menu-toggle__close"><Icon name="close" /></span>
      <span class="visually-hidden">Menu</span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul role="list">
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
      <Button href={donateHref} variant="primary" class="site-nav__donate">
        <Icon name="heart" size={18} /> Donate
      </Button>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(251 246 236 / 0.86);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .site-header.is-scrolled { border-color: var(--line); box-shadow: 0 6px 20px -16px rgb(11 39 64 / 0.4); }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.75rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--navy);
    flex-shrink: 0;
  }
  .brand__word { display: flex; flex-direction: column; line-height: 1; }
  .brand__courage {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 700;
    font-size: 1.5rem;
    letter-spacing: -0.02em;
  }
  .brand__for {
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--navy-900);
    padding-left: 0.15rem;
    margin-top: 0.2rem;
  }

  .site-nav { display: flex; align-items: center; gap: 1.25rem; }
  .site-nav ul { display: flex; flex-wrap: wrap; gap: 0.25rem; margin: 0; padding: 0; list-style: none; }
  .site-nav a:not(.btn) {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: 999px;
    color: var(--navy-900);
    font-weight: 600;
    font-size: 0.97rem;
    text-decoration: none;
    transition: background-color 0.15s;
  }
  .site-nav a:not(.btn):hover { background: var(--cream-200); }
  .site-nav a[aria-current='page'] { background: var(--white); box-shadow: inset 0 -3px 0 var(--yellow); }

  .menu-toggle {
    display: none;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    border: 2px solid var(--navy-900);
    border-radius: 999px;
    background: var(--white);
    color: var(--navy-900);
    cursor: pointer;
  }
  .menu-toggle__close { display: none; }
  .menu-toggle[aria-expanded='true'] .menu-toggle__open { display: none; }
  .menu-toggle[aria-expanded='true'] .menu-toggle__close { display: block; }

  @media (max-width: 64rem) {
    :global(.js) .menu-toggle { display: grid; }
    :global(.js) .site-nav {
      position: absolute;
      inset: 100% 0 auto 0;
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 1rem;
      padding: 1rem var(--gutter) 1.5rem;
      background: var(--cream);
      border-bottom: 1px solid var(--line);
      box-shadow: 0 20px 30px -24px rgb(11 39 64 / 0.5);
    }
    :global(.js) .site-nav.is-open { display: flex; }
    :global(.js) .site-nav ul { flex-direction: column; }
    :global(.js) .site-nav a:not(.btn) { padding: 0.85rem 1rem; font-size: 1.1rem; }
    /* Without JS the nav simply wraps under the logo. */
    :global(html:not(.js)) .site-header__inner { flex-wrap: wrap; padding-block: 0.75rem; }
    :global(html:not(.js)) .site-nav { flex-wrap: wrap; }
  }
</style>
