---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';

interface Props { story: CollectionEntry<'stories'> }
const { story } = Astro.props;
const date = story.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---

<article class="story" data-reveal>
  <p class="story__meta"><span class="story__tag">{story.data.tag}</span> <time datetime={story.data.date.toISOString()}>{date}</time></p>
  <h3><a href={`/stories/${story.id}/`}>{story.data.title}</a></h3>
  <p>{story.data.summary}</p>
  <span class="story__more" aria-hidden="true">Read story <Icon name="arrow" size={18} /></span>
</article>

<style>
  .story {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 2rem;
    background: var(--cream);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    transition: transform 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }
  .story:hover { transform: translateY(-3px); box-shadow: var(--shadow-lift); }
  .story h3 { font-size: var(--step-2); }
  .story h3 a { color: inherit; text-decoration: none; }
  .story h3 a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .story h3 a:focus-visible { outline: none; }
  .story:has(a:focus-visible) { outline: 3px solid var(--focus); outline-offset: 3px; }
  .story p { color: var(--ink-soft); }
  .story__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; font-size: var(--step--1); margin-bottom: 1rem; }
  .story__tag { padding: 0.2rem 0.7rem; border-radius: 999px; background: var(--yellow); color: var(--navy-900); font-weight: 700; }
  .story__more { display: inline-flex; align-items: center; gap: 0.4rem; margin-top: auto; font-weight: 700; color: var(--navy); }
</style>
