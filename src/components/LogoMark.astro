---
/**
 * The heart-and-cape mark, redrawn as an inline SVG so it stays crisp and
 * themeable. Replace with the official vector from the Canva Brand Kit when
 * it is exported (see docs/BRAND.md).
 */
interface Props {
  size?: number;
  class?: string;
  title?: string;
}
const { size = 44, class: className, title } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  aria-label={title}
  focusable="false"
>
  <path d="M17 31C9 36 4 44 2.5 54c6-4.5 13-7 21-7.5L17 31Z" fill="#FED438" />
  <path
    d="M32 57C14 43 5.5 33.5 5.5 22.6 5.5 14.6 11.8 8.4 19.6 8.4c5.2 0 9.8 2.8 12.4 7.1 2.6-4.3 7.2-7.1 12.4-7.1 7.8 0 14.1 6.2 14.1 14.2C58.5 33.5 50 43 32 57Z"
    fill="#004F81"
  />
  <circle cx="32" cy="23.5" r="5.6" fill="#FBF6EC" />
  <path
    d="M21.5 27.5c3 4.2 6.3 6.6 10.5 6.6s7.5-2.4 10.5-6.6c.9 1.6.8 3.4-.4 5L36.5 39v5.8L32 49.5l-4.5-4.7V39l-5.6-6.5c-1.2-1.6-1.3-3.4-.4-5Z"
    fill="#FBF6EC"
  />
</svg>
