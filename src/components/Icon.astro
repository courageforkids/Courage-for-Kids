  hospital: '<path d="M4 21V7.5L12 3l8 4.5V21"/><path d="M2.5 21h19M10 21v-4h4v4"/><path d="M12 7.5v5M9.5 10h5"/>',
  star: '<path d="m12 3.2 2.6 5.4 5.9.8-4.3 4.1 1 5.8L12 16.6l-5.2 2.7 1-5.8-4.3-4.1 5.9-.8L12 3.2Z"/>',
  megaphone: '<path d="M3.5 10v4c0 .6.4 1 1 1h2.5l7.5 4.5v-15L7 9H4.5c-.6 0-1 .4-1 1Z"/><path d="M7 15l1.4 5h2.4l-1-4.4M17.5 9.2a4 4 0 0 1 0 5.6M19.8 7a7 7 0 0 1 0 10"/>',
