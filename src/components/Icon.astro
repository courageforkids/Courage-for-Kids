---
/** Hand-drawn-feel line icons (24×24, 1.75 stroke). Decorative unless `label` is set. */
import type { IconName } from './icon-names';

interface Props {
  name: IconName;
  size?: number;
  label?: string;
  class?: string;
}
const { name, size = 24, label, class: className } = Astro.props;

const paths: Record<IconName, string> = {
